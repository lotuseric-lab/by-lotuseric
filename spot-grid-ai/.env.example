# Exchange selection: exactly one active public market-data source.
SMART_GRID_EXCHANGE=okx

# Configure feed URLs only after reviewing their publishers.
# Supported categories: crypto_media, exchange_official, macro_calendar, social
# Trust tiers: official, reputable, unverified
NEWS_FEEDS_JSON=[]

# Public official announcement APIs (no exchange API keys required).
ENABLE_OFFICIAL_EXCHANGE_NEWS=true

# Optional curated public Bluesky handles, comma-separated; posts remain unverified.
# Example: analyst.bsky.social,project.bsky.social
BLUESKY_ACTORS=

# Supabase credentials are server-side secrets. Never place the service-role key
# in frontend code, a public repository, or a mobile app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HTTP_TIMEOUT=15

# Snapshot writes are opt-in to avoid creating a DB row on every chart refresh.
PERSIST_MARKET_SNAPSHOTS=false

# Protect manual/automation-triggered feed ingestion from public callers.
# Generate a long random value and keep it only in the server environment.
SMART_GRID_SYNC_TOKEN=

# Paper mode is mandatory in V1. No exchange private API keys are required.
SMART_GRID_MODE=paper
LIVE_TRADING_ENABLED=false
