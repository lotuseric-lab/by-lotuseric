# Exchange selection: exactly one active public market-data source.
SMART_GRID_EXCHANGE=okx

# Configure feed URLs only after reviewing their publishers.
# Supported categories: crypto_media, exchange_official, macro_calendar, social
# Trust tiers: official, reputable, unverified
NEWS_FEEDS_JSON=[]

# Supabase credentials are server-side secrets. Never place the service-role key
# in frontend code, a public repository, or a mobile app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HTTP_TIMEOUT=15

# Paper mode is mandatory in V1. No exchange private API keys are required.
SMART_GRID_MODE=paper
LIVE_TRADING_ENABLED=false
