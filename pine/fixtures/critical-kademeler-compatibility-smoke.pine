//@version=6
indicator("Kritik Kademeler Breakout + Dinamik Pivot TP — uyumluluk testi", overlay=true, max_lines_count=500, max_labels_count=500)
leftBars = input.int(5, "Pivot Sol", minval=1)
rightBars = input.int(5, "Pivot Sağ", minval=1)
rsiLen = input.int(14, "RSI")
var array<float> pivotHighs = array.new_float()
var array<float> pivotLows = array.new_float()
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)
if not na(ph)
    array.unshift(pivotHighs, ph)
if not na(pl)
    array.unshift(pivotLows, pl)
if array.size(pivotHighs) > 20
    array.pop(pivotHighs)
if array.size(pivotLows) > 20
    array.pop(pivotLows)
rsiValue = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
atrValue = ta.atr(14)
avgVolume = ta.sma(volume, 20)
trendEma = ta.ema(close, 50)
bull = not na(ph) and close > ph + atrValue * 0.25 and close > trendEma and volume > avgVolume * 1.2
bear = not na(pl) and close < pl - atrValue * 0.25 and close < trendEma and volume > avgVolume * 1.2
var line resistance = na
var label pivotLabel = na
if not na(ph)
    if not na(resistance)
        line.delete(resistance)
    resistance := line.new(bar_index - rightBars, ph, bar_index, ph, color=color.red, width=2)
    if not na(pivotLabel)
        label.delete(pivotLabel)
    pivotLabel := label.new(bar_index - rightBars, ph, str.tostring(ph, format.mintick), style=label.style_label_down, textcolor=color.white)
if not na(resistance)
    line.set_x2(resistance, bar_index)
var table dashboard = table.new(position.top_right, 2, 4)
if barstate.islast
    table.cell(dashboard, 0, 0, "RSI")
    table.cell(dashboard, 1, 0, str.tostring(rsiValue))
    table.cell(dashboard, 0, 1, "MACD")
    table.cell(dashboard, 1, 1, macdLine > signalLine ? "BOGA" : "AYI")
    table.cell(dashboard, 0, 2, "Pivot High")
    table.cell(dashboard, 1, 2, array.size(pivotHighs) > 0 ? str.tostring(array.get(pivotHighs, 0)) : "Yok")
    table.cell(dashboard, 0, 3, "Pivot Low")
    table.cell(dashboard, 1, 3, array.size(pivotLows) > 0 ? str.tostring(array.get(pivotLows, 0)) : "Yok")
plotshape(bull, title="BOS AL", style=shape.labelup, location=location.belowbar, color=color.green, text="AL", textcolor=color.white)
plotshape(bear, title="BOS SAT", style=shape.labeldown, location=location.abovebar, color=color.red, text="SAT", textcolor=color.white)
plot(histLine, "MACD Histogram", color=color.blue)
alertcondition(bull, title="AL Sinyali", message="AL")
alertcondition(bear, title="SAT Sinyali", message="SAT")
