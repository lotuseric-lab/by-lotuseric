//@version=5
indicator("MONEY TRADER Destek/Direnç", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════
// GİRİŞLER
// ══════════════════════════════════════
grpMain   = "Ana Ayarlar"
grpVisual = "Görsel"
grpSignal = "Sinyaller"
grpFilter = "Filtreler (Hacim/RSI/Momentum)"

leftBars    = input.int(2, "Sol Bar Sayısı", minval=1, maxval=20, group=grpMain)
rightBars   = input.int(2, "Sağ Bar Sayısı", minval=1, maxval=20, group=grpMain)
maxLevels   = input.int(1, "Maksimum Seviye Sayısı", minval=1, maxval=50, group=grpMain)

showLabels  = input.bool(true, "Seviye Fiyat Etiketlerini Göster", group=grpVisual)
extendLines = input.bool(true, "Çizgileri Sağa Uzat", group=grpVisual)
lineLength  = input.int(100, "Çizgi / Etiket Sağ Ofseti", minval=20, maxval=500, group=grpVisual)
lineWidth   = input.int(2, "Çizgi Kalınlığı", minval=1, maxval=4, group=grpVisual)

showSignals = input.bool(true, "LONG / SHORT Sinyallerini Göster", group=grpSignal)
showSigPrice = input.bool(true, "Sinyalde Kapanış Fiyatını Göster", group=grpSignal)

// --- YENİ FİLTRE AYARLARI ---
useVolFilter = input.bool(true, "Hacim Filtresini Kullan", group=grpFilter)
volLength    = input.int(20, "Hacim Ortalama Periyodu", minval=5, group=grpFilter)
volMultiplier = input.float(1.2, "Hacim Çarpanı (Ortalamanın Kaç Katı?)", minval=0.5, step=0.1, group=grpFilter)

useRsiFilter = input.bool(true, "RSI Filtresini Kullan", group=grpFilter)
rsiLength    = input.int(14, "RSI Periyodu", minval=2, group=grpFilter)
rsiLongLevel = input.int(50, "LONG için Min RSI", minval=0, maxval=100, group=grpFilter)
rsiShortLevel = input.int(50, "SHORT için Max RSI", minval=0, maxval=100, group=grpFilter)

useMomFilter = input.bool(true, "Momentum Filtresini Kullan", group=grpFilter)
momLength    = input.int(10, "Momentum Periyodu", minval=1, group=grpFilter)

// ══════════════════════════════════════
// RENKLER
// ═════════════════════════════════════
resColor      = color.new(color.red, 0)
supColor      = color.new(color.lime, 0)
longColor     = color.new(color.lime, 0)
shortColor    = color.new(color.red, 0)
resLabelColor = color.new(color.red, 75)
supLabelColor = color.new(color.green, 75)

// ══════════════════════════════════════
// ANINDA PIVOT TESPİTİ
// ═════════════════════════════════════
totalBars = leftBars + rightBars
highestInLookback = ta.highest(high, totalBars)
lowestInLookback = ta.lowest(low, totalBars)

isPivotHigh = high == highestInLookback and high[1] < highestInLookback[1]
isPivotLow = low == lowestInLookback and low[1] > lowestInLookback[1]

// ══════════════════════════════════════
// FİLTRE HESAPLAMALARI
// ═════════════════════════════════════
// RSI
rsiValue = ta.rsi(close, rsiLength)

// Momentum (Close - Close[n])
momValue = ta.mom(close, momLength)

// Hacim Ortalaması
avgVolume = ta.sma(volume, volLength)
isHighVolume = volume > (avgVolume * volMultiplier)

// ═════════════════════════════════════
// ARRAY'LER
// ═════════════════════════════════════
var array<float> resistanceLevels = array.new_float()
var array<float> supportLevels    = array.new_float()

var array<line> resLines = array.new_line()
var array<line> supLines = array.new_line()

var array<label> resLabels = array.new_label()
var array<label> supLabels = array.new_label()

var array<int> resCreatedBars = array.new_int()
var array<int> supCreatedBars = array.new_int()

var array<bool> resBroken = array.new_bool()
var array<bool> supBroken = array.new_bool()

// ══════════════════════════════════════
// YARDIMCI FONKSİYONLAR
// ═════════════════════════════════════
deleteLevelLine(line ln) =>
    if not na(ln)
        line.delete(ln)

deleteLevelLabel(label lb) =>
    if not na(lb)
        label.delete(lb)

formatPrice(float price) =>
    str.tostring(price, format.mintick)

// ══════════════════════════════════════
// YENİ DİRENÇ EKLE (ANINDA!)
// ════════════════════════════════════
if isPivotHigh
    if array.size(resistanceLevels) >= maxLevels
        array.shift(resistanceLevels)
        line oldLine = array.shift(resLines)
        deleteLevelLine(oldLine)
        label oldLabel = array.shift(resLabels)
        deleteLevelLabel(oldLabel)
        array.shift(resCreatedBars)
        array.shift(resBroken)

    int rightX = bar_index + lineLength

    line newResLine = line.new(
         x1 = bar_index,
         y1 = high,
         x2 = rightX,
         y2 = high,
         xloc = xloc.bar_index,
         extend = extendLines ? extend.right : extend.none,
         color = resColor,
         width = lineWidth,
         style = line.style_solid)

    label newResLabel = na
    if showLabels
        newResLabel := label.new(
             x = rightX,
             y = high,
             text = "DİRENÇ " + formatPrice(high),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = resLabelColor,
             textcolor = color.white,
             size = size.small)

    array.push(resistanceLevels, high)
    array.push(resLines, newResLine)
    array.push(resLabels, newResLabel)
    array.push(resCreatedBars, bar_index)
    array.push(resBroken, false)

// ══════════════════════════════════════
// YENİ DESTEK EKLE (ANINDA!)
// ═════════════════════════════════════
if isPivotLow
    if array.size(supportLevels) >= maxLevels
        array.shift(supportLevels)
        line oldLine = array.shift(supLines)
        deleteLevelLine(oldLine)
        label oldLabel = array.shift(supLabels)
        deleteLevelLabel(oldLabel)
        array.shift(supCreatedBars)
        array.shift(supBroken)

    int rightX = bar_index + lineLength

    line newSupLine = line.new(
         x1 = bar_index,
         y1 = low,
         x2 = rightX,
         y2 = low,
         xloc = xloc.bar_index,
         extend = extendLines ? extend.right : extend.none,
         color = supColor,
         width = lineWidth,
         style = line.style_solid)

    label newSupLabel = na
    if showLabels
        newSupLabel := label.new(
             x = rightX,
             y = low,
             text = "DESTEK " + formatPrice(low),
             xloc = xloc.bar_index,
             style = label.style_label_left,
             color = supLabelColor,
             textcolor = color.white,
             size = size.small)

    array.push(supportLevels, low)
    array.push(supLines, newSupLine)
    array.push(supLabels, newSupLabel)
    array.push(supCreatedBars, bar_index)
    array.push(supBroken, false)

// ══════════════════════════════════════
// ÇİZGİ VE ETİKETLERİ SAĞA TAŞI
// ═════════════════════════════════════
if extendLines and array.size(resLines) > 0
    for i = 0 to array.size(resLines) - 1
        line ln = array.get(resLines, i)
        line.set_x2(ln, bar_index + lineLength)
        if showLabels
            label lb = array.get(resLabels, i)
            if not na(lb)
                label.set_x(lb, bar_index + lineLength)

if extendLines and array.size(supLines) > 0
    for i = 0 to array.size(supLines) - 1
        line ln = array.get(supLines, i)
        line.set_x2(ln, bar_index + lineLength)
        if showLabels
            label lb = array.get(supLabels, i)
            if not na(lb)
                label.set_x(lb, bar_index + lineLength)

// ══════════════════════════════════════
// KIRILIM SİNYALLERİ + FİLTRELER
// ═════════════════════════════════════
bool longSignal  = false
bool shortSignal = false
float brokenResistance = na
float brokenSupport    = na

// Mum kapandığında kontrol et (REPAINT YOK!)
if barstate.isconfirmed and bar_index > 0
    
    // --- FİLTRE KOŞULLARI ---
    // Hacim Kontrolü
    bool volCondition = useVolFilter ? isHighVolume : true
    
    // RSI Kontrolü
    bool rsiLongCond = useRsiFilter ? (rsiValue > rsiLongLevel) : true
    bool rsiShortCond = useRsiFilter ? (rsiValue < rsiShortLevel) : true
    
    // Momentum Kontrolü
    bool momLongCond = useMomFilter ? (momValue > 0) : true
    bool momShortCond = useMomFilter ? (momValue < 0) : true

    // DİRENÇ KIRILIMI = LONG
    if array.size(resistanceLevels) > 0
        for i = 0 to array.size(resistanceLevels) - 1
            float level = array.get(resistanceLevels, i)
            int createdBar = array.get(resCreatedBars, i)
            bool isBroken = array.get(resBroken, i)
            bool levelIsActive = bar_index > createdBar

            // Temel Kırılım Koşulu
            bool basicBreakout = levelIsActive and not isBroken and close > level and close[1] <= level
            
            // Filtrelerle Birleşik Koşul
            if basicBreakout and volCondition and rsiLongCond and momLongCond
                array.set(resBroken, i, true)
                if na(brokenResistance) or level > brokenResistance
                    brokenResistance := level

    // DESTEK KIRILIMI = SHORT
    if array.size(supportLevels) > 0
        for i = 0 to array.size(supportLevels) - 1
            float level = array.get(supportLevels, i)
            int createdBar = array.get(supCreatedBars, i)
            bool isBroken = array.get(supBroken, i)
            bool levelIsActive = bar_index > createdBar

            // Temel Kırılım Koşulu
            bool basicBreakdown = levelIsActive and not isBroken and close < level and close[1] >= level
            
            // Filtrelerle Birleşik Koşul
            if basicBreakdown and volCondition and rsiShortCond and momShortCond
                array.set(supBroken, i, true)
                if na(brokenSupport) or level < brokenSupport
                    brokenSupport := level

    longSignal  := not na(brokenResistance)
    shortSignal := not na(brokenSupport)

// ══════════════════════════════════════
// LONG / SHORT GÖRSELLERİ
// ════════════════════════════════════
plotshape(
     showSignals and longSignal,
     title = "LONG - Güçlü Kırılım",
     text = "LONG",
     style = shape.labelup,
     location = location.belowbar,
     color = longColor,
     textcolor = color.white,
     size = size.small)

plotshape(
     showSignals and shortSignal,
     title = "SHORT - Güçlü Kırılım",
     text = "SHORT",
     style = shape.labeldown,
     location = location.abovebar,
     color = shortColor,
     textcolor = color.white,
     size = size.small)

// LONG etiketi
if showSignals and longSignal
    string longText = "🟢 LONG\n" +
         "DİRENÇ KIRILDI\n" +
         "Seviye: " + formatPrice(brokenResistance)
    if showSigPrice
        longText := longText + "\nKapanış: " + formatPrice(close)
    
    label.new(
         x = bar_index,
         y = low,
         text = longText,
         xloc = xloc.bar_index,
         style = label.style_label_up,
         color = longColor,
         textcolor = color.white,
         size = size.small)

// SHORT etiketi
if showSignals and shortSignal
    string shortText = "🔴 SHORT\n" +
         "DESTEK KIRILDI\n" +
         "Seviye: " + formatPrice(brokenSupport)
    if showSigPrice
        shortText := shortText + "\nKapanış: " + formatPrice(close)
    
    label.new(
         x = bar_index,
         y = high,
         text = shortText,
         xloc = xloc.bar_index,
         style = label.style_label_down,
         color = shortColor,
         textcolor = color.white,
         size = size.small)

// ══════════════════════════════════════
// ALARMLAR
// ═════════════════════════════════════
alertcondition(
     longSignal,
     title = "LONG - Filtreli Direnç Kırıldı",
     message = "LONG: {{ticker}} {{interval}} direnç yukarı kırıldı (Hacim/RSI/Mom Onaylı). Kapanış: {{close}}")

alertcondition(
     shortSignal,
     title = "SHORT - Filtreli Destek Kırıldı",
     message = "SHORT: {{ticker}} {{interval}} destek aşağı kırıldı (Hacim/RSI/Mom Onaylı). Kapanış: {{close}}")

// ══════════════════════════════════════
// SABİTLER
// ══════════════════════════════════════
GRP_MAIN   = "️ Ana Ayarlar"
GRP_FILTER = "🔍 Filtreler"
GRP_VISUAL = "🎨 Görsel"
GRP_RISK   = "️ Risk Yönetimi"
GRP_LINES  = "📐 Kanal Çizgileri"
GRP_ALERT  = " Uyarılar"
GRP_COLORS = " Renkler"
GRP_ADV    = " Gelişmiş"
GRP_SIGNAL = " Sinyaller"

INDICATOR_VERSION = "v1.7.0"
int MAX_PIVOTS         = 60
int RESCAN_INTERVAL    = 10
int MAX_PIVOT_SCAN     = 15
int WARMUP_MINIMUM     = 50
float LINE_EPSILON     = 1e-10
float MAX_WIDTH_MULT   = 10.0
float VOL_CONTR_THRESH = 0.85
float BG_TRANSPARENCY  = 90.0
int MAX_HIST_LINES     = 400
int MAX_HIST_FILLS     = 200
int MAX_HIST_LABELS    = 200

// ══════════════════════════════════════
// GİRİŞLER (INPUTS)
// ══════════════════════════════════════
pivotLenInput = input.int(5, "Pivot Tespit Uzunluğu", minval = 2, maxval = 30, group = GRP_MAIN, tooltip = "Salınım pivot tespiti için sol/sağ bar sayısı.\n• Önerilen: 3–10")
minTouchesInput = input.int(2, "Sınır Başına Min Temas", minval = 2, maxval = 6, group = GRP_MAIN, tooltip = "Trend çizgisi başına minimum pivot teması.\n• Önerilen: 2–3")
maxChannelBarsInput = input.int(120, "Maks Kanal Genişliği (bar)", minval = 20, maxval = 500, step = 10, group = GRP_MAIN, tooltip = "Maksimum geriye dönük bakış.\n• Önerilen: 60–150")
convergenceMinInput = input.float(0.02, "Min Yakınsama Oranı", minval = 0.0, maxval = 0.5, step = 0.01, group = GRP_MAIN, tooltip = "Min daralma oranı (0–1).\n• Önerilen: 0.02–0.15")
touchToleranceInput = input.float(0.15, "Temas Toleransı (ATR)", minval = 0.01, maxval = 0.5, step = 0.01, group = GRP_ADV, tooltip = "Temas olarak sayılacak pivot mesafesi.\n• Önerilen: 0.10–0.25")
deviationMaxInput = input.float(0.3, "Maks Sapma (ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = GRP_ADV, tooltip = "Maksimum pivot sapması.\n• Önerilen: 0.2–0.5")
minChannelWidthAtrInput = input.float(0.5, "Min Kanal Genişliği (ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = GRP_ADV, tooltip = "Min genişlik filtresi.\n• Önerilen: 0.3–1.0")

volConfirmInput = input.float(1.2, "Hacim Artış Çarpanı", minval = 0.5, maxval = 3.0, step = 0.1, group = GRP_FILTER, tooltip = "Hacim vs SMA(20).\n• Forex için devre dışı bırakmak üzere 0.5 yapın")
volContractionInput = input.bool(true, "Hacim Daralma Filtresi", group = GRP_FILTER, tooltip = "Kanal içinde hacim düşüşü gerektir")
momentumFilterInput = input.bool(true, "Momentum Onayı", group = GRP_FILTER, tooltip = "Boğa için RSI > 50, ayı için < 50")

showPatternsInput    = input.bool(true, "Kanal Modellerini Göster", group = GRP_VISUAL)
showSignalsInput     = input.bool(true, "Kırılım Sinyallerini Göster", group = GRP_VISUAL)
showBgInput          = input.bool(false, "Model Arka Planını Göster", group = GRP_VISUAL, tooltip = "Fiyat kanal içindeyken hafif arka plan rengi")
historyModeInput     = input.string("Sadece Son", "Model Geçmişi", options = ["Tümü", "Sadece Son"], group = GRP_VISUAL, tooltip = "Tümü: tam geçmiş | Sadece Son: temiz grafik")
labelSizeInput       = input.string("Küçük", "Etiket Boyutu", options = ["Çok Küçük", "Küçük", "Normal"], group = GRP_VISUAL, tooltip = "▲ ▼  etiketlerinin boyutu")
showWatermarkInput   = input.bool(true, "Filigran Göster", group = GRP_VISUAL)

showFillInput        = input.bool(true, "Kanal İçi Dolguyu Göster", group = GRP_LINES, tooltip = "Kanal sınırları arasındaki gölgeli alanı göster/gizle")
lineColorInput       = input.color(#FFEB3B, "Çizgi Rengi", group = GRP_LINES, tooltip = "Kanal sınır çizgilerinin rengi (kırılımdan önce)")
lineWidthInput       = input.int(2, "Çizgi Kalınlığı", minval = 1, maxval = 4, group = GRP_LINES, tooltip = "Kanal sınır çizgilerinin kalınlığı.\n• 1 = ince\n• 2 = varsayılan\n• 3–4 = kalın")

showLevelsInput = input.bool(true, "İşlem Seviyelerini Göster", group = GRP_RISK, tooltip = "Giriş / SL / TP1 / TP2 / TP3 çizgilerini ve etiketlerini göster")
slPaddingInput = input.float(0, "SL Boşluğu (ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_RISK, tooltip = "SL için karşı sınırın ötesindeki ekstra tampon.\n• 0 = tam sınırda\n• 0.2 = sınır + 0.2×ATR\n• Önerilen: 0.1–0.3")
labelOffsetInput = input.int(20, "Etiket Ofseti (bar)", minval = 5, maxval = 50, group = GRP_RISK, tooltip = "Seviye etiketlerini son mumun ne kadar sağına yerleştireceği.\n• Önerilen: 15–25")

themeInput = input.string("Otomatik", "Tema", options = ["Otomatik", "Koyu", "Açık"], group = GRP_VISUAL)

bullColorInput    = input.color(#00E676, "Boğa (Yükseliş)", inline = "colors", group = GRP_COLORS)
bearColorInput    = input.color(#FF5252, "Ayı (Düşüş)", inline = "colors", group = GRP_COLORS)
neutralColorInput = input.color(#FFEB3B, "Nötr", inline = "colors", group = GRP_COLORS)

webhookInput = input.bool(false, "Webhook JSON Formatı", group = GRP_ALERT)

// YENİ EKLENEN AYAR: MİNİMUM SİNYAL ARALIĞI
minSignalGap = input.int(5, "Min Sinyal Aralığı (Bar)", minval = 1, maxval = 50, group = GRP_SIGNAL, tooltip = "Aynı yönde tekrar sinyal vermesi için geçmesi gereken minimum bar sayısı.")

// ══════════════════════════════════════
// TEMA TESPİTİ & RENKLER
// ══════════════════════════════════════
isDark = switch themeInput
    "Koyu"  => true
    "Açık" => false
    => color.r(chart.bg_color) < 128

TEXT_COLOR    = isDark ? #E0E0E0 : #1A1A1A
TEXT_MUTED    = isDark ? color.new(#9E9E9E, 0) : color.new(#757575, 0)
TEXT_BRIGHT   = isDark ? #FFFFFF : #000000
TABLE_BG      = isDark ? color.new(#131722, 5) : color.new(#FFFFFF, 5)
TABLE_BORDER  = isDark ? color.new(#2A2E39, 0) : color.new(#D0D0D0, 0)
TABLE_ROW_ALT = isDark ? color.new(#1C2030, 0) : color.new(#F0F4F8, 0)
HEADER_BG     = color.new(#2962FF, 0)
LINE_SUBTLE   = isDark ? color.new(#555555, 0) : color.new(#AAAAAA, 0)
WM_COLOR      = isDark ? color.new(#FFFFFF, 80) : color.new(#000000, 80)
INVALID_COLOR = isDark ? color.new(#FF9800, 0) : color.new(#E65100, 0)

DASH_GREEN  = isDark ? color.new(#00E676, 0) : color.new(#1B8A2A, 0)
DASH_RED    = isDark ? color.new(#FF5252, 0) : color.new(#CC1A1A, 0)
DASH_CYAN   = isDark ? color.new(#40E0D0, 0) : color.new(#0E8C7F, 0)

BULL_BG = color.new(bullColorInput, 88)
BEAR_BG = color.new(bearColorInput, 88)
CHANNEL_LINE_COLOR = color.new(lineColorInput, 50)

SL_COLOR     = color.new(#FF1744, 0)
TP_COLOR     = color.new(#00E676, 0)
ENTRY_COLOR  = color.new(#2979FF, 0)
TP_HIT_COLOR = color.new(#40E0D0, 0)
CHANNEL_FILL_COLOR = showFillInput ? color.new(lineColorInput, 90) : color.new(lineColorInput, 100)

// ══════════════════════════════════════
// ÇÖZÜCÜLER (RESOLVERS)
// ══════════════════════════════════════
lblSize = switch labelSizeInput
    "Çok Küçük" => size.tiny
    "Normal"    => size.normal
    => size.small

// ══════════════════════════════════════
// SAF FONKSİYONLAR (Global bağımlılık yok)
// ══════════════════════════════════════
safeDiv(float num, float den, float fallback = 0.0) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

lineAt(float x1, float y1, float x2, float y2, float x) =>
    float dx = x2 - x1
    math.abs(dx) > LINE_EPSILON ? y1 + (y2 - y1) * (x - x1) / dx : y1

// ══════════════════════════════════════
// TEMEL HESAPLAMALAR
// ══════════════════════════════════════
float atr20    = nz(ta.atr(20), syminfo.mintick * 10)
float rsiVal   = nz(ta.rsi(close, 14), 50.0)
float volSma   = nz(ta.sma(volume, 20), 0.0)
bool  hasVolume = nz(volume, 0) > 0
float cumVol   = ta.cum(nz(volume, 0))

int WARMUP_BARS = math.max(pivotLenInput * 2 + maxChannelBarsInput, WARMUP_MINIMUM)
bool isWarmedUp = bar_index >= WARMUP_BARS
bool showLastOnly = historyModeInput == "Sadece Son"

// ══════════════════════════════════════
// PİVOT TESPİTİ
// ══════════════════════════════════════
float pivHigh = ta.pivothigh(high, pivotLenInput, pivotLenInput)
float pivLow  = ta.pivotlow(low, pivotLenInput, pivotLenInput)

var array<float> hiPrices = array.new_float()
var array<int>   hiBars   = array.new_int()
var array<float> loPrices = array.new_float()
var array<int>   loBars   = array.new_int()

if not na(pivHigh)
    hiPrices.unshift(pivHigh)
    hiBars.unshift(bar_index - pivotLenInput)
if not na(pivLow)
    loPrices.unshift(pivLow)
    loBars.unshift(bar_index - pivotLenInput)

while hiPrices.size() > MAX_PIVOTS
    hiPrices.pop()
    hiBars.pop()
while loPrices.size() > MAX_PIVOTS
    loPrices.pop()
    loBars.pop()

// ══════════════════════════════════════
// KANAL DURUMU
// ══════════════════════════════════════
var bool     channelActive  = false
var float    hiX1 = 0.0
var float    hiY1 = 0.0
var float    hiX2 = 0.0
var float    hiY2 = 0.0
var float    loX1 = 0.0
var float    loY1 = 0.0
var float    loX2 = 0.0
var float    loY2 = 0.0
var int      chHiTouches   = 0
var int      chLoTouches   = 0
var float    chConvergence = 0.0
var float    chMaxWidth    = 0.0
var int      chDetectBar   = 0
var line     chHiLine      = na
var line     chLoLine      = na
var linefill chFill        = na

var int    breakoutDir     = 0
var int    breakoutBar     = 0
var float  targetPrice     = 0.0
var string breakStrength   = "—"
var bool   breakInvalid    = false
var float  volContraction  = 0.0
var float  entryPrice      = 0.0
var float  slPrice         = 0.0
var float  slPriceOrig     = 0.0
var float  tp1Price        = 0.0
var float  tp2Price        = 0.0
var float  tp3Price        = 0.0
var bool   tp1Hit = false
var bool   tp2Hit = false
var bool   tp3Hit = false
var bool   slHit  = false
var bool   tradeOpen = false

var int    totalPatterns   = 0
var int    bullBreaks      = 0
var int    bearBreaks      = 0
var int    invalidCount    = 0
var int    winCount        = 0
var int    lossCount       = 0
var int    lastSignalBar   = 0
var string lastSignalType  = "—"
var float  dirScore        = 50.0

var array<line>     histLines  = array.new<line>()
var array<linefill> histFills  = array.new<linefill>()
var array<label>    histLabels = array.new<label>()

// İşlem seviyesi çizim nesneleri
var line lineEntry  = na
var line lineSL     = na
var line lineTP1    = na
var line lineTP2    = na
var line lineTP3    = na
var label lbEntry   = na
var label lbSL      = na
var label lbTP1     = na
var label lbTP2     = na
var label lbTP3     = na
var bool hasTradeDrawings = false

// ══════════════════════════════════════
// FONKSİYONLAR
// ══════════════════════════════════════
formatAlertMsg(string action, string emoji, string strLbl, float _entry, float _sl, float _tp1, float _tp2, float _tp3) =>
    string tickerStr = syminfo.tickerid
    string tfStr     = timeframe.period
    string priceStr  = str.tostring(close, format.mintick)
    string slAlStr   = str.tostring(_sl, format.mintick)
    string t1Str     = str.tostring(_tp1, format.mintick)
    string t2Str     = str.tostring(_tp2, format.mintick)
    string t3Str     = str.tostring(_tp3, format.mintick)
    string jsonMsg   = '{"action":"' + action + '","ticker":"' + tickerStr + '","price":' + priceStr + ',"sl":' + slAlStr + ',"tp1":' + t1Str + ',"tp2":' + t2Str + ',"tp3":' + t3Str + ',"strength":"' + strLbl + '","tf":"' + tfStr + '"}'
    string textMsg   = emoji + " " + str.upper(action) + " [" + strLbl + "] | " + tickerStr + " | " + tfStr + " | Giriş: " + priceStr + " | SL: " + slAlStr + " | TP1: " + t1Str + " | TP2: " + t2Str + " | TP3: " + t3Str
    webhookInput ? jsonMsg : textMsg

formatEventMsg(string eventName, string emoji) =>
    string p = str.tostring(close, format.mintick)
    webhookInput ? '{"event":"' + eventName + '","ticker":"' + syminfo.tickerid + '","price":' + p + '}' : emoji + " " + str.upper(eventName) + " | " + syminfo.tickerid + " | " + p

deleteTradeDrawings() =>
    line.delete(lineEntry)
    line.delete(lineSL)
    line.delete(lineTP1)
    line.delete(lineTP2)
    line.delete(lineTP3)
    label.delete(lbEntry)
    label.delete(lbSL)
    label.delete(lbTP1)
    label.delete(lbTP2)
    label.delete(lbTP3)

deleteTradeLabels() =>
    label.delete(lbEntry)
    label.delete(lbSL)
    label.delete(lbTP1)
    label.delete(lbTP2)
    label.delete(lbTP3)

// ══════════════════════════════════════
// SINIR UYUMLU KANAL TESPİTİ
// ═════════════════════════════════════
bool newPivot = not na(pivHigh) or not na(pivLow)
bool rescanDue = bar_index % RESCAN_INTERVAL == 0
bool shouldScan = (newPivot or rescanDue) and not channelActive and not tradeOpen and isWarmedUp and hiPrices.size() >= minTouchesInput and loPrices.size() >= minTouchesInput

bool channelJustDetected = false

if shouldScan
    var array<float> hX = array.new_float()
    var array<float> hY = array.new_float()
    var array<float> lX = array.new_float()
    var array<float> lY = array.new_float()
    hX.clear()
    hY.clear()
    lX.clear()
    lY.clear()

    for i = 0 to math.min(hiPrices.size() - 1, MAX_PIVOT_SCAN)
        if bar_index - hiBars.get(i) <= maxChannelBarsInput
            hX.push(float(hiBars.get(i)))
            hY.push(hiPrices.get(i))
    for i = 0 to math.min(loPrices.size() - 1, MAX_PIVOT_SCAN)
        if bar_index - loBars.get(i) <= maxChannelBarsInput
            lX.push(float(loBars.get(i)))
            lY.push(loPrices.get(i))

    int hCnt = hX.size()
    int lCnt = lX.size()
    float devTol   = atr20 * deviationMaxInput
    float touchTol = atr20 * touchToleranceInput

    float bestHiX1 = 0.0
    float bestHiY1 = 0.0
    float bestHiX2 = 0.0
    float bestHiY2 = 0.0
    int   bestHiTouches = 0
    bool  foundHi = false

    if hCnt >= minTouchesInput
        for a = 0 to hCnt - 2
            for b = a + 1 to hCnt - 1
                float ax = hX.get(a)
                float ay = hY.get(a)
                float bx = hX.get(b)
                float bPy = hY.get(b)
                if math.abs(bx - ax) >= 1.0
                    bool allBelow = true
                    int  touches = 0
                    for k = 0 to hCnt - 1
                        float projY = lineAt(ax, ay, bx, bPy, hX.get(k))
                        float diff = hY.get(k) - projY
                        if diff > devTol
                            allBelow := false
                            break
                        if math.abs(diff) <= touchTol
                            touches += 1
                    if allBelow and touches >= minTouchesInput and touches > bestHiTouches
                        bestHiTouches := touches
                        bestHiX1 := ax
                        bestHiY1 := ay
                        bestHiX2 := bx
                        bestHiY2 := bPy
                        foundHi  := true

    float bestLoX1 = 0.0
    float bestLoY1 = 0.0
    float bestLoX2 = 0.0
    float bestLoY2 = 0.0
    int   bestLoTouches = 0
    bool  foundLo = false

    if lCnt >= minTouchesInput
        for a = 0 to lCnt - 2
            for b = a + 1 to lCnt - 1
                float ax = lX.get(a)
                float ay = lY.get(a)
                float bx = lX.get(b)
                float bPy = lY.get(b)
                if math.abs(bx - ax) >= 1.0
                    bool allAbove = true
                    int  touches = 0
                    for k = 0 to lCnt - 1
                        float projY = lineAt(ax, ay, bx, bPy, lX.get(k))
                        float diff = lY.get(k) - projY
                        if diff < -devTol
                            allAbove := false
                            break
                        if math.abs(diff) <= touchTol
                            touches += 1
                    if allAbove and touches >= minTouchesInput and touches > bestLoTouches
                        bestLoTouches := touches
                        bestLoX1 := ax
                        bestLoY1 := ay
                        bestLoX2 := bx
                        bestLoY2 := bPy
                        foundLo  := true

    if foundHi and foundLo
        float hiMinX = math.min(bestHiX1, bestHiX2)
        float hiMaxX = math.max(bestHiX1, bestHiX2)
        float loMinX = math.min(bestLoX1, bestLoX2)
        float loMaxX = math.max(bestLoX1, bestLoX2)
        float overlapStart = math.max(hiMinX, loMinX)
        float overlapEnd   = math.min(hiMaxX, loMaxX)
        float maxH = 0.0
        if overlapEnd > overlapStart
            int samples = math.max(int((overlapEnd - overlapStart) / 5.0), 2)
            for s = 0 to samples
                float sx = overlapStart + (overlapEnd - overlapStart) * float(s) / float(samples)
                float hu = lineAt(bestHiX1, bestHiY1, bestHiX2, bestHiY2, sx)
                float lo = lineAt(bestLoX1, bestLoY1, bestLoX2, bestLoY2, sx)
                if hu - lo > maxH
                    maxH := hu - lo
        else
            float midX = (hiMinX + hiMaxX + loMinX + loMaxX) / 4.0
            maxH := math.abs(lineAt(bestHiX1, bestHiY1, bestHiX2, bestHiY2, midX) - lineAt(bestLoX1, bestLoY1, bestLoX2, bestLoY2, midX))

        float startX     = math.min(math.min(bestHiX1, bestHiX2), math.min(bestLoX1, bestLoX2))
        float endX       = float(bar_index)
        float upperNow   = lineAt(bestHiX1, bestHiY1, bestHiX2, bestHiY2, endX)
        float lowerNow   = lineAt(bestLoX1, bestLoY1, bestLoX2, bestLoY2, endX)
        float widthNow   = upperNow - lowerNow
        float upperStart = lineAt(bestHiX1, bestHiY1, bestHiX2, bestHiY2, startX)
        float lowerStart = lineAt(bestLoX1, bestLoY1, bestLoX2, bestLoY2, startX)
        float widthStart = upperStart - lowerStart
        float convRate   = widthStart > 0 ? 1.0 - safeDiv(widthNow, widthStart, 1.0) : 0.0
        bool  notInv     = widthNow > 0
        bool  isConv     = convRate >= convergenceMinInput
        bool  widthOk    = widthNow >= atr20 * minChannelWidthAtrInput and widthNow < atr20 * MAX_WIDTH_MULT
        bool  isInside   = notInv and close[1] <= upperNow and close[1] >= lowerNow

        int patStartIdx = int(startX)
        int patBars     = math.max(bar_index - patStartIdx, 1)

        int safPatBars  = math.min(patBars, bar_index)
        int preBars     = math.min(safPatBars, patStartIdx)
        float volInPat  = hasVolume and safPatBars > 0 ? safeDiv(cumVol - nz(cumVol[safPatBars], 0.0), float(safPatBars), volSma) : volSma
        float volPrePat = hasVolume and preBars > 0 ? safeDiv(nz(cumVol[safPatBars], 0.0) - nz(cumVol[safPatBars + preBars], 0.0), float(preBars), volSma) : volSma
        float volContRatio = safeDiv(volInPat, volPrePat, 1.0)
        bool  volContOk = volContractionInput ? (not hasVolume or volContRatio < VOL_CONTR_THRESH) : true

        if notInv and isConv and widthOk and isInside and volContOk
            if showLastOnly
                for ln in histLines
                    line.delete(ln)
                histLines.clear()
                for fl in histFills
                    linefill.delete(fl)
                histFills.clear()
                for lb in histLabels
                    label.delete(lb)
                histLabels.clear()
                hasTradeDrawings := false

            channelActive  := true
            hiX1 := bestHiX1
            hiY1 := bestHiY1
            hiX2 := bestHiX2
            hiY2 := bestHiY2
            loX1 := bestLoX1
            loY1 := bestLoY1
            loX2 := bestLoX2
            loY2 := bestLoY2
            chHiTouches   := bestHiTouches
            chLoTouches   := bestLoTouches
            chConvergence := convRate
            chMaxWidth    := maxH
            chDetectBar   := bar_index
            breakoutDir   := 0
            breakInvalid  := false
            breakStrength := "—"
            volContraction := volContRatio
            channelJustDetected := true
            totalPatterns += 1

// ── Geçmiş dizilerini sınırsız büyümeye karşı kırp ──
while histLines.size() > MAX_HIST_LINES
    line.delete(histLines.shift())
while histFills.size() > MAX_HIST_FILLS
    linefill.delete(histFills.shift())
while histLabels.size() > MAX_HIST_LABELS
    label.delete(histLabels.shift())

// ── Aktif kanalı çiz / uzat ──
if channelActive and showPatternsInput
    float hiProjNow = lineAt(hiX1, hiY1, hiX2, hiY2, float(bar_index))
    float loProjNow = lineAt(loX1, loY1, loX2, loY2, float(bar_index))

    if channelJustDetected
        int drawStart  = int(math.min(math.min(hiX1, hiX2), math.min(loX1, loX2)))
        float hiStartY = lineAt(hiX1, hiY1, hiX2, hiY2, float(drawStart))
        float loStartY = lineAt(loX1, loY1, loX2, loY2, float(drawStart))
        if not na(chHiLine)
            line.delete(chHiLine)
        if not na(chLoLine)
            line.delete(chLoLine)
        if not na(chFill)
            linefill.delete(chFill)
        chHiLine := line.new(drawStart, hiStartY, bar_index, hiProjNow, color = CHANNEL_LINE_COLOR, width = lineWidthInput)
        chLoLine := line.new(drawStart, loStartY, bar_index, loProjNow, color = CHANNEL_LINE_COLOR, width = lineWidthInput)
        chFill   := linefill.new(chHiLine, chLoLine, CHANNEL_FILL_COLOR)
        histLines.push(chHiLine)
        histLines.push(chLoLine)
        histFills.push(chFill)
    else
        if not na(chHiLine)
            line.set_x2(chHiLine, bar_index)
            line.set_y2(chHiLine, hiProjNow)
        if not na(chLoLine)
            line.set_x2(chLoLine, bar_index)
            line.set_y2(chLoLine, loProjNow)

// ══════════════════════════════════════
// KIRILIM TESPİTİ + GÜÇ
// ══════════════════════════════════════
bool rawBullBreak = false
bool rawBearBreak = false
float strengthScore = 0.0
float breakBoundary = 0.0
float oppBoundary   = 0.0

bool channelMature = channelActive and breakoutDir == 0

if channelMature and barstate.isconfirmed and isWarmedUp
    float upper     = lineAt(hiX1, hiY1, hiX2, hiY2, float(bar_index))
    float lower     = lineAt(loX1, loY1, loX2, loY2, float(bar_index))
    float bodyLen   = math.abs(close - open)
    float candleLen = high - low
    float bodyRatio = candleLen > 0 ? bodyLen / candleLen : 0.0
    float bodyMid   = (open + close) / 2.0
    bool  volOk     = hasVolume ? volume > volSma * volConfirmInput : true
    bool  momOk     = momentumFilterInput ? (close > upper ? rsiVal > 50 : rsiVal < 50) : true

    if close > upper
        rawBullBreak := true
        breakBoundary := upper
        oppBoundary   := lower
        float penetration = atr20 > 0 ? math.min((close - upper) / atr20, 2.0) / 2.0 : 0.5
        float bodyCommit  = bodyMid > upper ? 1.0 : 0.3
        float volBonus    = volOk ? 1.0 : 0.4
        float momBonus    = momOk ? 1.0 : 0.4
        strengthScore := (penetration * 0.25 + bodyRatio * 0.15 + bodyCommit * 0.15 + volBonus * 0.25 + momBonus * 0.20) * 100

    if close < lower
        rawBearBreak := true
        breakBoundary := lower
        oppBoundary   := upper
        float penetration = atr20 > 0 ? math.min((lower - close) / atr20, 2.0) / 2.0 : 0.5
        float bodyCommit  = bodyMid < lower ? 1.0 : 0.3
        float volBonus    = volOk ? 1.0 : 0.4
        float momBonus    = momOk ? 1.0 : 0.4
        strengthScore := (penetration * 0.25 + bodyRatio * 0.15 + bodyCommit * 0.15 + volBonus * 0.25 + momBonus * 0.20) * 100

// ══════════════════════════════════════
// YÖNSEL PUANLAMA
// ══════════════════════════════════════
if channelActive and breakoutDir == 0
    float upperNow  = lineAt(hiX1, hiY1, hiX2, hiY2, float(bar_index))
    float lowerNow  = lineAt(loX1, loY1, loX2, loY2, float(bar_index))
    float upperPrev = lineAt(hiX1, hiY1, hiX2, hiY2, float(bar_index - 1))
    float lowerPrev = lineAt(loX1, loY1, loX2, loY2, float(bar_index - 1))
    float midSlope  = ((upperNow + lowerNow) - (upperPrev + lowerPrev)) / 2.0
    float slopeBias = midSlope > 0 ? math.min(midSlope / (atr20 * 0.01), 1.0) : math.max(midSlope / (atr20 * 0.01), -1.0)
    float rsiBias   = (rsiVal - 50.0) / 50.0
    float chRange   = upperNow - lowerNow
    float posInCh   = chRange > 0 ? (close - lowerNow) / chRange : 0.5
    float posBias   = (posInCh - 0.5) * 2.0
    float combined  = slopeBias * 0.35 + rsiBias * 0.35 + posBias * 0.30
    dirScore := math.max(0.0, math.min(100.0, 50.0 + combined * 50.0))

if not channelActive
    dirScore := 50.0

// ══════════════════════════════════════
// SİNYAL İŞLEME + HEDEF
// ══════════════════════════════════════
bool confirmedBullBreak = rawBullBreak
bool confirmedBearBreak = rawBearBreak

if confirmedBullBreak
    breakoutDir   := 1
    breakoutBar   := bar_index
    entryPrice    := close
    slPrice       := oppBoundary - atr20 * slPaddingInput
    slPriceOrig   := slPrice
    targetPrice   := breakBoundary + chMaxWidth
    float fullMove = math.abs(targetPrice - entryPrice)
    tp1Price      := entryPrice + fullMove / 3.0
    tp2Price      := entryPrice + fullMove * 2.0 / 3.0
    tp3Price      := entryPrice + fullMove
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    slHit  := false
    tradeOpen := true
    breakInvalid  := false
    breakStrength := strengthScore >= 65 ? "Güçlü" : strengthScore >= 35 ? "Orta" : "Zayıf"
    bullBreaks    += 1
    lastSignalBar  := bar_index
    lastSignalType := "Boğa Kırılımı"
    if not na(chHiLine)
        line.set_color(chHiLine, color.new(bullColorInput, 40))
        line.set_width(chHiLine, lineWidthInput)
    if not na(chLoLine)
        line.set_color(chLoLine, color.new(bullColorInput, 40))
        line.set_width(chLoLine, lineWidthInput)
    if not na(chFill)
        linefill.set_color(chFill, showFillInput ? BULL_BG : color.new(bullColorInput, 100))

if confirmedBearBreak
    breakoutDir   := -1
    breakoutBar   := bar_index
    entryPrice    := close
    slPrice       := oppBoundary + atr20 * slPaddingInput
    slPriceOrig   := slPrice
    targetPrice   := breakBoundary - chMaxWidth
    float fullMove = math.abs(entryPrice - targetPrice)
    tp1Price      := entryPrice - fullMove / 3.0
    tp2Price      := entryPrice - fullMove * 2.0 / 3.0
    tp3Price      := entryPrice - fullMove
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    slHit  := false
    tradeOpen := true
    breakInvalid  := false
    breakStrength := strengthScore >= 65 ? "Güçlü" : strengthScore >= 35 ? "Orta" : "Zayıf"
    bearBreaks    += 1
    lastSignalBar  := bar_index
    lastSignalType := "Ayı Kırılımı"
    if not na(chHiLine)
        line.set_color(chHiLine, color.new(bearColorInput, 40))
        line.set_width(chHiLine, lineWidthInput)
    if not na(chLoLine)
        line.set_color(chLoLine, color.new(bearColorInput, 40))
        line.set_width(chLoLine, lineWidthInput)
    if not na(chFill)
        linefill.set_color(chFill, showFillInput ? BEAR_BG : color.new(bearColorInput, 100))

// ══════════════════════════════════════
// KANAL ZAMAN AŞIMI
// ══════════════════════════════════════
if channelActive and breakoutDir == 0 and bar_index - chDetectBar > maxChannelBarsInput
    channelActive := false

// ══════════════════════════════════════
// TP / SL TETİKLEME TESPİTİ
// ══════════════════════════════════════
if tradeOpen and breakoutDir != 0 and not slHit and bar_index > breakoutBar
    bool tpSide   = breakoutDir == 1 ? high >= tp1Price : low <= tp1Price
    bool tp2Side  = breakoutDir == 1 ? high >= tp2Price : low <= tp2Price
    bool tp3Side  = breakoutDir == 1 ? high >= tp3Price : low <= tp3Price
    bool slSide   = breakoutDir == 1 ? low <= slPrice  : high >= slPrice

    if slSide
        slHit := true
        if not tp1Hit
            lossCount += 1
    else
        if tpSide and not tp1Hit
            tp1Hit := true
            winCount += 1
            slPrice := entryPrice
            if not na(lbEntry)
                label.set_text(lbEntry, "GİRİŞ " + str.tostring(entryPrice, format.mintick) + " (SL → BAŞABAŞ)")
            if not na(lbSL)
                string slPctUpd = str.tostring(math.abs(slPriceOrig - entryPrice) / entryPrice * 100, "#.##") + "%"
                label.set_text(lbSL, "Orijinal SL " + str.tostring(slPriceOrig, format.mintick) + " (−" + slPctUpd + ")")
                label.set_color(lbSL, color.new(SL_COLOR, 75))
        if tp2Side and not tp2Hit
            tp2Hit := true
        if tp3Side and not tp3Hit
            tp3Hit := true

var int lastBreakoutDir = 0
if tradeOpen and (tp3Hit or slHit)
    lastBreakoutDir := breakoutDir
    tradeOpen := false
    channelActive := false
    breakoutDir   := 0
    if not showLastOnly
        deleteTradeLabels()
        hasTradeDrawings := false

// ══════════════════════════════════════
// İŞLEM SEVİYE ÇİZGİLERİ & ETİKETLERİ
// ══════════════════════════════════════
if (confirmedBullBreak or confirmedBearBreak) and showLevelsInput
    if showLastOnly
        deleteTradeDrawings()
    else
        deleteTradeLabels()

    int lineEnd  = bar_index + labelOffsetInput
    int labelPos = bar_index + labelOffsetInput + 2